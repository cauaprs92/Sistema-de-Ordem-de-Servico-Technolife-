# Copie para .env e ajuste os valores. Nunca commitar .env com segredos reais.

NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://technoloife:technoloife@localhost:5432/technoloife?schema=public
REDIS_URL=redis://localhost:6379

# Gere um valor com: openssl rand -base64 32
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=15m

FISCAL_PROVIDER=mock
FISCAL_API_KEY=

STORAGE_PATH=./storage
TZ=America/Sao_Paulo

# Web
NEXT_PUBLIC_API_URL=http://localhost:3333/v1
